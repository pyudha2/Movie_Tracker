generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id        String      @id @default(cuid())
  email     String      @unique
  name      String      @unique
  password  String?
  watchlist Watchlist[]
  createdAt DateTime    @default(now())
  resetToken        String?  @unique
  resetTokenExpiry  DateTime?
  provider          String    @default("credentials")
  image          String?
  emailVerified  DateTime?
}

model Watchlist {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  mediaId   Int
  mediaType MediaType
  title     String
  posterUrl String?
  status    Status    @default(PLAN_TO_WATCH)
  rating    Int?
  review    String?
  createdAt DateTime  @default(now())

  @@unique([userId, mediaId, mediaType])
}

enum MediaType {
  MOVIE
  ANIME
}

enum Status {
  PLAN_TO_WATCH
  WATCHING
  COMPLETED
  DROPPED
}